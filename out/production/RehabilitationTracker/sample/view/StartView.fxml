<?xml version="1.0" encoding="UTF-8"?>

<!--
    StartView.fxml
    Diese View zeigt die Startseite der Anwendung.
    Sie enthält den Anwendungstitel, das Logo und eine Ladeanzeige.
    Die Animation und der automatische Wechsel zur LoginView werden im StartController gesteuert.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>

<BorderPane prefHeight="750" prefWidth="800" style="-fx-background-color: #dfe8f1;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.StartController">

    <!-- Kopfbereich mit Titel und Untertitel -->
    <top>
        <VBox spacing="5" style="-fx-background-color: #243447;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20"/>
            </padding>

            <Label text="Rehabilitation Tracker" fx:id="titleLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Übungsmanagement für Ihre Rehabilitation" fx:id="subtitleLabel" style="-fx-font-size: 14px; -fx-text-fill: #d6e4f0;"/>
        </VBox>
    </top>

    <!-- Mittelbereich mit Logo -->
    <center>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20"/>
            </padding>

            <ImageView fitHeight="500" preserveRatio="true" fx:id="logoView">
                <Image url="@../graphics/logo.png"/>
            </ImageView>
        </VBox>
    </center>

    <!-- Unterer Bereich mit Ladeanzeige -->
    <bottom>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20"/>
            </padding>
            <Label fx:id="loadingLabel" text="Laden ..." style="-fx-text-fill: #243447; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ProgressIndicator fx:id="loadingCircle" prefWidth="45" prefHeight="45"/>
        </VBox>
    </bottom>
</BorderPane>
