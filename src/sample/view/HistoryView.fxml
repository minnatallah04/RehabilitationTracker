<?xml version="1.0" encoding="UTF-8"?>

<!--
    HistoryView.fxml
    Diese View zeigt das Übungsprotokoll einer ausgewählten Person.
    In der Tabelle werden Übung, erledigte Wiederholungen und Datum angezeigt.
    Die Daten werden im HistoryController geladen und gefiltert.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<BorderPane prefHeight="550" prefWidth="600" style="-fx-background-color: #dfe8f1;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.HistoryController">

    <!-- Kopfbereich mit Personendaten und Titel -->
    <top>
        <VBox spacing="6" style="-fx-background-color: #243447;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20"/>
            </padding>

            <Label fx:id="personLabel" text="Person" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Übungsprotokoll" style="-fx-text-fill: #d6e4f0; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <!-- Mittelbereich mit Historientabelle -->
    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>

            <!-- Karte mit Übungsprotokoll und Schließen-Button -->
            <VBox spacing="14" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18;">
                <TableView fx:id="historyTable" prefHeight="400" prefWidth="550" style="-fx-font-size: 13px;">
                    <columns>
                        <TableColumn fx:id="exerciseColumn" text="Übung" prefWidth="250"/>
                        <TableColumn fx:id="repsColumn" text="Wiederholungen" prefWidth="130"/>
                        <TableColumn fx:id="dateColumn" text="Datum" prefWidth="170"/>
                    </columns>
                </TableView>
                <Button text="Schließen" onAction="#closeWindow" prefWidth="180" prefHeight="38"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
