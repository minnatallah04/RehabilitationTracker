<?xml version="1.0" encoding="UTF-8"?>

<!--
    MainView.fxml
    Diese View zeigt das Dashboard der Anwendung.
    Hier werden Personen angezeigt, gesucht, erstellt, gelöscht und einem Arzt zugeordnet.
    Die gesamte Logik wird im MainController gesteuert.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>

<BorderPane prefHeight="850" prefWidth="950" style="-fx-background-color: #d6e0ea;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.MainController">

    <!-- Kopfbereich mit Dashboard-Titel -->
    <top>
        <VBox spacing="6" style="-fx-background-color: #243447;">
            <padding>
                <Insets top="22" right="28" bottom="22" left="28"/>
            </padding>

            <Label text="Dashboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Personen verwalten" style="-fx-font-size: 14px; -fx-text-fill: #d6e4f0;"/>
        </VBox>
    </top>

    <!-- Mittelbereich mit Suche, Tabelle und Arztzuordnung -->
    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="24" right="28" bottom="16" left="28"/>
            </padding>

            <!-- Karte für Personenübersicht -->
            <VBox spacing="14" style="-fx-background-color: #f1f5f9; -fx-background-radius: 14; -fx-padding: 18;">

                <!-- Suchleiste und Benutzeraktionen -->
                <HBox spacing="12">
                    <TextField fx:id="searchField" promptText="Person suchen..." prefWidth="280"
                               style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                    <Button text="Suchen" onAction="#searchPerson"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 18;"/>
                    <Button text="Aktualisieren" onAction="#refreshPersons"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 18;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="registerButton" text="Personal registrieren" onAction="#openRegisterView"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 18;"/>
                    <Button text="Abmelden" onAction="#logout"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 9 18;"/>
                </HBox>

                <Label text="Personenübersicht" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Tabelle mit allen Personen -->
                <TableView fx:id="personsTable">
                    <columns>
                        <TableColumn text="ID" fx:id="idColumn" prefWidth="130" style="-fx-alignment: CENTER;"/>
                        <TableColumn text="Name" fx:id="nameColumn" prefWidth="240" style="-fx-alignment: CENTER;"/>
                        <TableColumn text="Geburtsdatum" fx:id="birthColumn" prefWidth="180" style="-fx-alignment: CENTER;"/>
                        <TableColumn text="Reha-Grund" fx:id="conditionColumn" prefWidth="280" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>

                <!-- Aktionen für ausgewählte Person und Arztzuordnung -->
                <HBox spacing="12">
                    <Button text="Person öffnen" onAction="#openSelectedPerson"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                    <Button text="Person löschen" onAction="#deleteSelectedPerson"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Unterer Bereich zum Anlegen neuer Personen und für Programmausgaben -->
    <bottom>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="28" bottom="24" left="28"/>
            </padding>

            <!-- Karte zum Erstellen einer neuen Person -->
            <VBox spacing="12" style=" -fx-background-color: #f1f5f9; -fx-background-radius: 14; -fx-padding: 18;">
                <Label text="Neue Person anlegen" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="12">
                    <TextField promptText="Name" fx:id="nameField" prefWidth="220" style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                    <DatePicker promptText="Geburtsdatum" fx:id="birthDatePicker" prefWidth="190" prefHeight="36" style="-fx-font-size: 13px; -fx-background-radius: 5;"/>
                    <TextField promptText="Reha-Grund" fx:id="conditionField" prefWidth="220" style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Person hinzufügen" onAction="#addPerson" defaultButton="true"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                </HBox>

                <!-- Programmausgaben -->
                <Label text="Programmausgabe..." style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextArea fx:id="logArea" prefHeight="85" editable="false"
                          style="-fx-font-family: 'Consolas'; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
