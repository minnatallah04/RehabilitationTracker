<?xml version="1.0" encoding="UTF-8"?>

<!--
    LoginView.fxml
    Diese View zeigt die Anmeldung für Mitarbeiter.
    Benutzer geben hier ihre E-Mail und ihr Passwort ein.
    Die Prüfung der Anmeldedaten und der Wechsel zur Hauptansicht erfolgen im LoginController.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<BorderPane prefHeight="800" prefWidth="850" style="-fx-background-color: #dfe8f1;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.LoginController">

    <!-- Kopfbereich mit Anwendungstitel -->
    <top>
        <VBox spacing="6" style="-fx-background-color: #243447;">
            <padding>
                <Insets top="22" right="28" bottom="22" left="28"/>
            </padding>

            <Label text="Rehabilitation Tracker" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Bitte melden Sie sich mit Ihrem Mitarbeiterkonto an" style="-fx-font-size: 14px; -fx-text-fill: #d6e4f0;"/>
        </VBox>
    </top>

    <!-- Mittelbereich mit Login-Formular -->
    <center>
        <VBox alignment="CENTER">

            <!-- Login-Karte mit Demo-Zugang, Eingabefeldern und Aktionen -->
            <VBox spacing="16" alignment="CENTER" maxWidth="790" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 35;">
                <Label text="Anmeldung" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Zugang nur für autorisiertes Personal" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="Demo-Zugang" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Chef-Account" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="E-Mail: chef@javafx.com" style="-fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                <Label text="Passwort: chef" style="-fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                <Label text="Benutzer-Account" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="E-Mail: user@javafx.com" style="-fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                <Label text="Passwort: user" style="-fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>

                <TextField fx:id="emailField" promptText="E-Mail oder Benutzername" maxWidth="320" prefHeight="38"
                           style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                <PasswordField fx:id="passwordField" promptText="Passwort" maxWidth="320" prefHeight="38"
                               style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>

                <!-- Fehlermeldung bei ungültigen Anmeldedaten -->
                <Label fx:id="errorLabel" textFill="red" wrapText="true"/>

                <!-- Aktionsbuttons -->
                <Button text="Anmelden" onAction="#handleLogin" prefWidth="320" prefHeight="40" defaultButton="true"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8;"/>
                <Button text="App schließen" onAction="#handleExit" prefWidth="320" prefHeight="38"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
