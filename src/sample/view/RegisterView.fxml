<?xml version="1.0" encoding="UTF-8"?>

<!--
    RegisterView.fxml
    Diese View zeigt die Registrierung für neue Mitarbeiterkonten.
    Sie ist nur für Chef oder autorisierte Leitung gedacht.
    Die Prüfung der Eingaben und das Speichern des Benutzers erfolgen im RegisterController.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<BorderPane prefHeight="750" prefWidth="850" style="-fx-background-color: #dfe8f1;"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.RegisterController">

    <!-- Kopfbereich mit Titel der Anwendung -->
    <top>
        <VBox spacing="6" style="-fx-background-color: #243447;">
            <padding>
                <Insets top="22" right="28" bottom="22" left="28"/>
            </padding>

            <Label text="Rehabilitation Tracker" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Neues Mitarbeiterkonto anlegen" style="-fx-font-size: 14px; -fx-text-fill: #d6e4f0;"/>
        </VBox>
    </top>

    <!-- Mittelbereich mit Registrierungsformular -->
    <center>
        <VBox alignment="CENTER">

            <!-- Formular-Karte mit Eingabefeldern und Aktionen -->
            <VBox spacing="14" alignment="CENTER" maxWidth="790"
                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 35;">

                <Label text="Registrierung" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Nur durch Chef oder autorisierte Leitung" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>

                <TextField fx:id="nameField" promptText="Name" maxWidth="360" prefHeight="38"
                           style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                <TextField fx:id="ageField" promptText="Alter" maxWidth="360" prefHeight="38"
                           style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                <TextField fx:id="emailField" promptText="E-Mail  ...@javafx.com" maxWidth="360" prefHeight="38"
                           style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                <PasswordField fx:id="passwordField" promptText="Passwort" maxWidth="360" prefHeight="38"
                               style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Passwort wiederholen" maxWidth="360" prefHeight="38"
                               style="-fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 9;"/>

                <!-- Fehlermeldung bei ungültigen Eingaben -->
                <Label fx:id="errorLabel" textFill="red" wrapText="true"/>

                <!-- Aktionsbuttons -->
                <Button text="Registrieren" onAction="#handleRegister" prefWidth="320" prefHeight="40"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;"/>
                <Button text="Abbrechen" onAction="#handleCancel" prefWidth="320" prefHeight="38"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;"/>
                <Button text="App schließen" onAction="#handleExit" prefWidth="320" prefHeight="38"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
